# Variables du serveur (Render / Railway / Hugging Face > Settings > Variables / Secrets)
AI_API_KEY=votre_cle_api
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_IMAGE_MODEL=gpt-image-1
# Facultatif : si le site est hébergé ailleurs que le serveur
CORS_ORIGINES=*
# Côté site (au moment du « npm run build ») si le serveur est sur un autre domaine
VITE_API_URL=
